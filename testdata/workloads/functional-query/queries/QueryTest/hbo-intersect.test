---- QUERY
# EXPLAIN the rewritten query which is equivalent to the INTERSECT query
EXPLAIN select * from (
  select distinct id from functional.alltypes
  where string_col != 'test_intersect'
) t1
where exists (
  select 1 from functional.alltypestiny t2
  where string_col != 'test_intersect' and t1.id <=> t2.id
)
